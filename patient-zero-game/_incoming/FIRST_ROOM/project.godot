; Engine configuration file.
; Open this project with Godot 4.2 or newer.
config_version=5

[application]
config/name="FIRST ROOM"
run/main_scene="res://Main.tscn"

[display]
window/size/viewport_width=1280
window/size/viewport_height=617
window/size/window_width_override=1280
window/size/window_height_override=617
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.0156863, 0.027451, 0.0470588, 1)
